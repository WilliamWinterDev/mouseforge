{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MouseForge",
  "version": "0.1.0",
  "identifier": "com.mouseforge.app",
  "build": { "frontendDist": "../ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MouseForge",
        "width": 1040,
        "height": 760,
        "minWidth": 760,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico", "icons/icon.png"]
  }
}
